{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],

    "module": "ESNext",
    "moduleResolution": "Bundler",

    "jsx": "react-jsx",

    "allowJs": true,
    "checkJs": false,

    "types": ["vite/client"],

    "skipLibCheck": true,
    "noEmit": true
  },

  "include": [
    "src/**/*.js",
    "src/**/*.jsx"
  ]
}